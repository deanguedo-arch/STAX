{
  "cases": [
    {
      "caseId": "wrong_commit_01",
      "description": "GitHub Actions run succeeded on an old commit.",
      "repo": "STAX",
      "workflow": "ci",
      "provider": "github_actions",
      "branch": "main",
      "commitSha": "old1234",
      "expectedCommitSha": "new1234",
      "conclusion": "success",
      "summary": "workflow completed successfully",
      "expectedLikelyCause": "wrong_commit",
      "expectedProofStrength": "stale_proof",
      "expectedNextActionContains": "head commit"
    },
    {
      "caseId": "wrong_branch_02",
      "description": "GitHub Actions run succeeded on the base branch instead of feature branch.",
      "repo": "STAX",
      "workflow": "ci",
      "provider": "github_actions",
      "branch": "main",
      "expectedBranch": "feature/proof",
      "conclusion": "success",
      "summary": "workflow completed successfully",
      "expectedLikelyCause": "wrong_branch",
      "expectedProofStrength": "wrong_branch_proof",
      "expectedNextActionContains": "correct branch"
    },
    {
      "caseId": "stale_run_03",
      "description": "Completed run is older than the required evidence timestamp.",
      "repo": "STAX",
      "workflow": "ci",
      "provider": "github_actions",
      "branch": "main",
      "commitSha": "abc1234",
      "conclusion": "success",
      "summary": "workflow completed successfully",
      "finishedAt": "2026-05-01T12:00:00.000Z",
      "evidenceRequiredAfter": "2026-05-02T12:00:00.000Z",
      "expectedLikelyCause": "stale_run",
      "expectedProofStrength": "stale_proof",
      "expectedNextActionContains": "newer workflow run"
    },
    {
